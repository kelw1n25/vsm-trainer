# Значения для локального демо. docker compose берёт их по умолчанию.
# Для любого другого окружения: cp .env.example .env и замените секреты в .env (он не коммитится).
POSTGRES_USER=vsm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vsm_trainer

# Секрет подписи JWT, не короче 32 символов.
# Сгенерировать свой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=demo-only-secret-replace-me-with-token-hex-32

# API-ключ интеграции с HR/LMS (заголовок X-API-Key), не короче 32 символов
INTEGRATION_API_KEY=demo-only-integration-key-replace-me-32

# Создать синтетических сотрудников и историю прохождений при первом запуске
SEED_DEMO_DATA=true
